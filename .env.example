# Copy to .env. Never commit real credentials.
INTERVIEW_AI_KEY=
INTERVIEW_AI_BASE_URL=https://api.openai.com/v1
# The selected model must accept image input through chat/completions.
INTERVIEW_AI_MODEL=gpt-4.1-mini
# Optional: a long shared device-pairing token; otherwise generated on startup.
INTERVIEW_PAIR_TOKEN=
